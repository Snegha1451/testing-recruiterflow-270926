{
  "name": "playwright-demo-suite",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript UI and API test suite (saucedemo.com + reqres.in)",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "test:debug": "playwright test --project=ui-chromium --debug",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.20.4",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0"
  }
}
